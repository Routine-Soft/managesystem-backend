PORT=8080

# MongoDB Atlas (o endereço do cluster fica no src/db/db.js)
MONGODB_USERNAME=
MONGODB_PASSWORD=

JWT_SECRET=

# Cifra as chaves do Mercado Pago/Stripe que os programadores cadastram (64 caracteres hexadecimais).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Não troque depois de ter clientes: as chaves salvas deixariam de abrir.
CHAVE_CRIPTOGRAFIA=

# Endereços públicos: do painel (frontend) e desta API (usado no comando de instalação do agente e nos webhooks)
# APP_URL=https://monitor.cestsegtrabalho.com.br
# APP_URL_BACKEND=https://api-monitor.cestsegtrabalho.com.br
APP_URL=http://localhost:5173
APP_URL_BACKEND=http://localhost:8080


# Stripe (cartão, todos os países)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (Pix, Brasil)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_TEST_PAYER_EMAIL=

# Telegram (token do bot criado no @BotFather e um segredo qualquer para o webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# 1 desliga as rotinas do monitor (útil para rodar uma segunda cópia da API)
MONITOR_DESLIGADO=
